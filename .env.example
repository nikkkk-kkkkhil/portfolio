# ─────────────────────────────────────────────────────────────
# THE MASKED MAN — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local dev:    postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production:   use a hosted Postgres (Neon, Supabase, Railway…)
#               e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Public URL of the deployed site — used for SEO metadata, Open Graph,
# sitemap and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
